@inherits LayoutComponentBase
@using lost_and_found.Services
@inject AuthService AuthService


<NavMenu></NavMenu>

<div class="main-content">
    @Body
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}