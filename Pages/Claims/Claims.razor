@page "/claims"
@using System.Security.Claims
@using lost_and_found.Components
@using lost_and_found.Models
@using lost_and_found.Services
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject AuthService AuthService


<div class="claims">
    <h2>My Reports & Claims</h2>
    <div class="stats">
        <div class="action">
            <p class="reports-stats">@ActiveReportCount</p>
            <p>Active reports</p>
        </div>
        <div class="action">
            <p class="claim-stats">@PendingClaimCount</p>
            <p>Pending Claim</p>
        </div>
        <div class="action">
            <p class="resolved-stats col-red">@ResolvedReportCount</p>
            <p>Resolved</p>
        </div>

    </div>
    <div class="selection @(isReports ? "reports-selected" : "claims-selected")" @onclick="triggerSelected">
        <div class="select-item @(isReports ? "is-selected" : "")">
            <p>My reports</p>
        </div>
        <div class="select-item @(!isReports ? "is-selected" : "")">
            <p>My Claims</p>
        </div>
    </div>
    <div class="data-container">
        @if (isReports)
        {
            @foreach (var item in ReportItems!)
            {
                @* <ClaimReportCard item="item"></ClaimReportCard> *@
                <div>
                    @* <p>@(item.Title)</p> *@
                    <ReportCard Item="@item" OnDeleted="HandleReportDeleted"></ReportCard>
                </div>
            }
        }
        else
        {
            @foreach (var item in ClaimItems!)
            {
                @* <ClaimReportCard item="item"></ClaimReportCard> *@
                <ClaimCard item="item"></ClaimCard>
            }
        }
    </div>
</div>

@code {
    private bool isReports = true;
    private string errorMessage;
    private bool isLoading;

    public List<ClaimItem> ClaimItems { get; set; } = [];
    public List<ReportItem> ReportItems { get; set; } = [];

    private int ActiveReportCount => ReportItems.Count(report => report.Status is 0 or 1 or 2);
    private int PendingClaimCount => ClaimItems.Count(claim => claim.status == 0);
    private int ResolvedReportCount => ReportItems.Count(report => report.Status == 2);

    private void triggerSelected()
    {
        isReports = !isReports;
    }

    private void HandleReportDeleted(ReportItem report)
    {
        ReportItems.Remove(report);
    }

    private async Task GetReportsClaims()
    {
        var reportresponse = await ApiService.GetUserReports();
        var claimresponse = await ApiService.GetUserClaims();

        @* if (reportresponse is not null) ReportItems = reportresponse; *@
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine(AuthService.CurrentUser);
        if (!AuthService.isLoggedIn)
        {
            Navigation.NavigateTo("/sign-in");
            return;
        }

        try
        {
            var reportsTask = ApiService.GetUserReports();
            var claimsTask = ApiService.GetUserClaims();

            await Task.WhenAll(reportsTask, claimsTask);

            ReportItems = reportsTask.Result ?? [];
            ClaimItems = claimsTask.Result ?? [];
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(ex);
            errorMessage = "Couldn't load your data. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}