@page "/claims"
@using System.Security.Claims
@using lost_and_found.Components
@using lost_and_found.Services
@inject ApiService ApiService


<div class="claims">
    <h2>My Reports & Claims</h2>
    <div class="stats">
        <div class="action">
            <p class="reports-stats">2</p>
            <p>Active reports</p>
        </div>
        <div class="action">
            <p class="claim-stats">1</p>
            <p>Pending Claim</p>
        </div>
        <div class="action">
            <p class="resolved-stats col-red">3</p>
            <p>Resolved</p>
        </div>
        
    </div>
    <div class="selection @(isReports ? "reports-selected" : "claims-selected")" @onclick="triggerSelected">
        <div class="select-item @(isReports ? "is-selected" : "")">
            <p>My reports</p>
        </div>
        <div class="select-item @(!isReports ? "is-selected" : "")">
            <p>My Claims</p>
        </div>
    </div>
    <div class="data-container">
        @foreach (var item in Items)
        {
            <ClaimReportCard item="item"></ClaimReportCard>
        }
    </div>
</div>

@code {
    private bool isReports = true;
    public IReadOnlyList<ClaimItem> Items = ClaimItemData.Items;

    private void triggerSelected()
    {
        isReports = !isReports;
    }



    async public void getClaims()
    {
        var response = await ApiService.GetUserClaims();
        if (response is null) return;
        foreach (var item in response!)
        {
            Console.WriteLine("Found");
            Console.WriteLine(item.claimerName);
        }
        @* Console.WriteLine(response); *@
    }





    protected override async void OnInitialized()
    {
        getClaims();
    }
}