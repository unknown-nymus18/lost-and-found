@page "/sign-in"
@using lost_and_found.Services
@layout EmptyLayout
@inject ApiService ApiService
@inject AuthService AuthService

<div class="sign-in">
    <div class="left">
        <a href="/">Go Home</a>
        <p class="heading">UG Lost & Found</p>
        <p class="title">Reuniting the campus community, one item at a time.</p>
        <p class="subtitle">Sign in with your University of Ghana account to report items, track claims, and get
            notified
            the moment a match is found.</p>
        </div>
        <div class="right">
            <fieldset>
                <legend class="heading">Welcome Back</legend>
                <p class="subtitle">Sign in to continue to your dashboard</p>
                <label>
                    Email Address
                    <input type="email" placeholder="you@st.ug.edu.gh" @bind="email" />
                </label>
                <label>
                    Password
                    <input type="password" required @bind="password" />
                </label>
                <a href="#" class="forgot-passwd">Forgot password?</a>
                <button type="submit" @onclick="loginUser">Sign In</button>
                <span class="nav">Don't have an account? <a href="#">Register</a></span>
                <span class="nav">Campus staff? <a href=""> Sign in to admin portal</a></span>
            </fieldset>
        </div>
    </div>


@code {
    private string email = string.Empty;
    private string password = string.Empty;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }
    async public void submitButton()
    {
        var res = await ApiService.RegisterUser("Felix", "felix@gmail.com", "12345678");
        Console.WriteLine(res);
    }

    public async Task loginUser()
    {
        if (email == string.Empty || password == string.Empty)
        {
            return;
        }
        var res = await ApiService.LoginUser(email, password);
        if (res is not null)
        {
            AuthService.SetUser(res);
        }
        Console.WriteLine(res);
    }
}