@page "/sign-in"
@using lost_and_found.Components
@using lost_and_found.Services
@layout EmptyLayout
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager NavManager

<div class="sign-in">
    <AuthPanel Headline="Reuniting the campus community, one item at a time."
               Blurb="Sign in with your University of Ghana account to report items, track claims, and get notified the moment a match is found." />
    <div class="right">
        <fieldset>
            <legend class="heading">Welcome Back</legend>
            <p class="subtitle">Sign in to continue to your dashboard</p>
            <label>
                Email Address
                <input type="email" placeholder="you@st.ug.edu.gh" @bind="email" />
            </label>
            <label>
                Password
                <input type="password" required @bind="password" />
            </label>
            <a href="/forgot-password" class="forgot-passwd">Forgot password?</a>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }
            <button type="button" disabled="@isSubmitting" aria-busy="@isSubmitting" @onclick="loginUser">
                @(isSubmitting ? "Signing in..." : "Sign In")
            </button>
            <span class="nav">Don't have an account? <a href="/register">Register</a></span>
            <span class="nav">Campus staff? <a href=""> Sign in to admin portal</a></span>
        </fieldset>
    </div>
</div>


@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool isSubmitting;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public async Task submitButton()
    {
        var res = await ApiService.RegisterUser("Felix", "felix@gmail.com", "12345678");
        Console.WriteLine(res);
    }

    public async Task loginUser()
    {
        if (isSubmitting) return;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Enter your email address and password.";
            return;
        }

        errorMessage = null;
        isSubmitting = true;
        try
        {
            var res = await ApiService.LoginUser(email.Trim(), password);
            if (res is not null)
            {
                if (res.role == "Admin")
                {
                    NavManager.NavigateTo("/admin");
                }
                else
                {
                    NavManager.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Sign-in failed. Check your details and try again.";
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}