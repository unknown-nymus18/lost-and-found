@page "/admin"
@layout EmptyLayout
@using lost_and_found.Components
@using lost_and_found.Models
@using lost_and_found.Services
@inject ApiService ApiService
@inject AdminService AdminService

<div class="admin-layout">
    <nav class="sidebar" aria-label="Admin navigation">
        <div class="sidebar-brand">UG Admin</div>
        <div class="sidebar-nav">
            @foreach (var section in Sections)
            {
                <button class="nav-trigger @(ActiveSection == section.Key ? "active" : "")" type="button" @onclick="() => ActiveSection = section.Key">@section.Value</button>
            }
        </div>
    </nav>

    <div class="main-panel">
        <header class="topbar">
            <h1>@SectionTitle</h1>
            <div class="admin-profile"><span class="avatar">KT</span><span>Admin - Kwabena T.</span></div>
        </header>

        <main class="admin-content">
            @if (IsLoading)
            {
                <p role="status">Loading live admin data...</p>
            }
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p role="alert">@ErrorMessage</p>
            }
            @if (ActiveSection == "overview")
            {
                <section>
                    <div class="dashboard-stats">
                        <article class="stat-card stat-card-blue"><strong>@Reports.Count</strong><span>Total Reports</span></article>
                        <article class="stat-card stat-card-amber"><strong>@ClaimRows.Count(c => c.Status == "Pending")</strong><span>Pending Claims</span></article>
                        <article class="stat-card stat-card-red"><strong>@ClaimRows.Count(c => c.Status == "Disputed")</strong><span>Flagged Disputes</span></article>
                        <article class="stat-card stat-card-green"><strong>@ClaimRows.Count(c => c.Status == "Approved")</strong><span>Reunited</span></article>
                    </div>
                    <section class="table-panel">
                        <div class="panel-heading"><h2>Recent Reports for Review</h2><button class="btn-primary" type="button">New Manual Entry</button></div>
                        <ReportTable Items="Reports.OrderByDescending(r => r.CreatedAt).Take(5)" />
                    </section>
                </section>
            }
            else if (ActiveSection == "reports")
            {
                <section>
                    <div class="report-toolbar">
                        <input type="search" @bind="ReportSearch" @bind:event="oninput" placeholder="Search by item, reporter, or location" aria-label="Search reports" />
                        <select @bind="ReportTypeFilter" aria-label="Filter report type"><option value="all">Type: All</option><option value="lost">Lost</option><option value="found">Found</option></select>
                        <select @bind="ReportCategoryFilter" aria-label="Filter report category"><option value="all">Category: All</option>@foreach (var category in CategoryOptions.Values) { <option value="@category">@category</option> }</select>
                        <button class="btn-primary" type="button">New Manual Entry</button>
                    </div>
                    <div class="dashboard-stats compact-stats">
                        <article class="stat-card stat-card-blue"><strong>@Reports.Count</strong><span>Total Reports</span></article>
                        <article class="stat-card stat-card-red"><strong>@Reports.Count(r => r.Status == 0)</strong><span>Lost</span></article>
                        <article class="stat-card stat-card-green"><strong>@Reports.Count(r => r.Status == 1)</strong><span>Found</span></article>
                        <article class="stat-card stat-card-amber"><strong>0</strong><span>Flagged</span></article>
                    </div>
                    <section class="table-panel"><ReportTable Items="FilteredReports" /></section>
                </section>
            }
            else if (ActiveSection == "matches")
            {
                <section>
                    <div class="match-summary">
                        <article class="match-summary-card review"><strong>@SuggestedMatches.Count(m => m.Status == "Awaiting Review")</strong><span>Awaiting Review</span></article>
                        <article class="match-summary-card confirmed"><strong>@SuggestedMatches.Count(m => m.Status == "Confirmed")</strong><span>Confirmed Matches</span></article>
                        <article class="match-summary-card dismissed"><strong>@SuggestedMatches.Count(m => m.Status == "Dismissed")</strong><span>Dismissed</span></article>
                        <article class="match-summary-card accuracy"><strong>@AverageMatchScore%</strong><span>Avg. Match Accuracy</span></article>
                    </div>
                    <div class="tabs" role="tablist">
                        @foreach (var status in MatchStatuses) { <button class="@(MatchStatusFilter == status ? "active" : "")" type="button" @onclick="() => MatchStatusFilter = status">@status@(status == "Awaiting Review" ? $" ({AwaitingMatchCount})" : "")</button> }
                    </div>
                    <div class="suggested-match-list">
                        @foreach (var match in FilteredSuggestedMatches)
                        {
                            <article class="suggested-match-card">
                                <div class="suggested-match-grid">
                                    <div class="match-item">
                                        @if (!string.IsNullOrWhiteSpace(match.LostImageUrl)) { <img class="match-item-image" src="@match.LostImageUrl" alt="Reported lost item: @match.LostTitle" /> }
                                        else { <span class="match-item-image skeleton" role="img" aria-label="No image supplied for this lost report"></span> }
                                        <div><span class="match-type lost">Lost</span><strong>@match.LostTitle</strong><small>@match.LostDetails</small></div>
                                    </div>
                                    <div class="match-confidence @ConfidenceClass(match.Confidence)"><strong>@match.Confidence%</strong><span>match</span></div>
                                    <div class="match-item">
                                        @if (!string.IsNullOrWhiteSpace(match.FoundImageUrl)) { <img class="match-item-image" src="@match.FoundImageUrl" alt="Reported found item: @match.FoundTitle" /> }
                                        else { <span class="match-item-image skeleton" role="img" aria-label="No image supplied for this found report"></span> }
                                        <div><span class="match-type found">Found</span><strong>@match.FoundTitle</strong><small>@match.FoundDetails</small></div>
                                    </div>
                                    <div class="match-actions"><button class="confirm-match" type="button" @onclick="() => OpenMatchDecision(match, true)">Confirm Match</button><button class="dismiss-match" type="button" @onclick="() => OpenMatchDecision(match, false)">Dismiss</button></div>
                                </div>
                                <p>Why suggested: @match.Reason</p>
                            </article>
                        }
                    </div>
                </section>
            }
            else if (ActiveSection == "claims")
            {
                <section>
                    <div class="dashboard-stats compact-stats">
                        <article class="stat-card stat-card-amber"><strong>@ClaimRows.Count(c => c.Status == "Pending")</strong><span>Pending Review</span></article>
                        <article class="stat-card stat-card-green"><strong>@ClaimRows.Count(c => c.Status == "Approved")</strong><span>Approved</span></article>
                        <article class="stat-card stat-card-red"><strong>@ClaimRows.Count(c => c.Status == "Rejected")</strong><span>Rejected</span></article>
                        <article class="stat-card stat-card-purple"><strong>@ClaimRows.Count(c => c.Status == "Disputed")</strong><span>Flagged Disputes</span></article>
                    </div>
                    <div class="claims-toolbar"><div class="tabs">@foreach (var status in ClaimStatuses) { <button class="@(ClaimStatusFilter == status ? "active" : "")" type="button" @onclick="() => ClaimStatusFilter = status">@status@(status == "Pending" ? $" ({PendingClaimCount})" : "")</button> }</div><input type="search" @bind="ClaimSearch" @bind:event="oninput" placeholder="Search claims" aria-label="Search claims" /></div>
                    <section class="table-panel claims-panel"><table class="claims-table"><thead><tr><th>Claim</th><th>Item</th><th>Claimant</th><th>Match</th><th>Submitted</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var claim in FilteredClaims) { <tr><td class="report-reference">@claim.Reference</td><td class="item-title">@claim.ItemTitle</td><td><span class="claimant"><span class="claimant-initials">@Initials(claim.Claimant)</span>@claim.Claimant</span></td><td><strong class="@ConfidenceClass(claim.MatchPercent)">@(claim.MatchPercent.HasValue ? $"{claim.MatchPercent}%" : "—")</strong></td><td>@claim.Submitted.ToString("MMM d, yyyy")</td><td><span class="status-badge @ClaimStatusClass(claim.Status)">@claim.Status</span></td><td class="row-actions">@if (claim.Status == "Pending") { <button type="button" @onclick="() => OpenClaimDecision(claim, true)">Approve</button><button type="button" @onclick="() => OpenClaimDecision(claim, false)">Reject</button> }</td></tr> }</tbody></table></section>
                    <p class="claim-note">Claims older than 7 days without admin action are escalated automatically.</p>
                </section>
            }
            else if (ActiveSection == "users")
            {
                <section>
                    <div class="dashboard-stats compact-stats"><article class="stat-card stat-card-blue"><strong>4,812</strong><span>Registered Users</span></article><article class="stat-card stat-card-green"><strong>1,093</strong><span>Active This Month</span></article><article class="stat-card stat-card-purple"><strong>8</strong><span>Staff &amp; Admins</span></article><article class="stat-card stat-card-red"><strong>5</strong><span>Suspended</span></article></div>
                    <div class="users-toolbar"><input type="search" @bind="UserSearch" @bind:event="oninput" placeholder="Search by name, student ID, or email" aria-label="Search users" /><select @bind="UserRoleFilter" aria-label="Filter role"><option value="all">Role: All</option><option>Student</option><option>Admin</option><option>Security Staff</option></select><select @bind="UserStatusFilter" aria-label="Filter status"><option value="all">Status: All</option><option value="active">Active</option><option value="suspended">Suspended</option></select><button class="btn-primary" type="button">+ Invite Staff</button></div>
                    <section class="table-panel users-panel"><table class="users-table"><thead><tr><th>Name</th><th>Student / Staff ID</th><th>Email</th><th>Role</th><th>Reports</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var user in FilteredUsers) { <tr><td class="item-title"><span class="user-name"><span class="user-initials">@Initials(user.Name)</span>@user.Name</span></td><td>@user.Identifier</td><td>@user.Email</td><td><span class="role-badge @RoleClass(user.Role)">@user.Role</span></td><td>@user.ReportCount</td><td><span class="status-badge @(user.Suspended ? "status-rejected" : "status-found")">@(user.Suspended ? "Suspended" : "Active")</span></td><td class="row-actions"><button type="button">Edit</button><button class="suspend-action" type="button">@(user.Suspended ? "Restore" : "Suspend")</button></td></tr> }</tbody></table></section>
                    <div class="users-pagination"><span>Showing 1-7 of 4,812 users</span><div><button type="button">&lt; Previous</button><button type="button">Next &gt;</button></div></div>
                </section>
            }
            else
            {
                <section class="settings-panel"><h2>Settings</h2><p>Admin settings will be connected when the backend management endpoints are available.</p></section>
            }
        </main>
    </div>
</div>

@if (SelectedClaim is not null)
{
    <div class="decision-backdrop" role="presentation" @onclick="CloseClaimDecision">
        <section class="decision-dialog" role="dialog" aria-modal="true" aria-labelledby="decision-title" @onclick:stopPropagation>
            <button class="decision-close" type="button" aria-label="Close" @onclick="CloseClaimDecision">&times;</button>
            <span class="decision-kicker">@SelectedClaim.Reference</span>
            <h2 id="decision-title">@(ApproveDecision ? "Approve this claim?" : "Reject this claim?")</h2>
            <p class="decision-summary"><strong>@SelectedClaim.Claimant</strong> is claiming <strong>@SelectedClaim.ItemTitle</strong>.</p>
            @if (ApproveDecision && (!SelectedClaim.MatchPercent.HasValue || SelectedClaim.MatchPercent < 70))
            {
                <p class="decision-warning" role="alert">@(SelectedClaim.MatchPercent.HasValue ? $"This claim has a low match score ({SelectedClaim.MatchPercent}%)." : "No match score is available for this claim.") Verify the claimant's proof and item details before approving.</p>
            }
            <label for="decision-note">@(ApproveDecision ? "Admin note / pickup instructions" : "Reason for rejection")</label>
            <textarea id="decision-note" @bind="DecisionNote" placeholder="@(ApproveDecision ? "Where, when and who to meet for collection" : "Please explain why this claim is being rejected")"></textarea>
            @if (string.IsNullOrWhiteSpace(DecisionNote))
            {
                <p class="decision-hint">@(ApproveDecision ? "A note is required. It will be shown to both the claimant and the finder." : "A rejection reason is required. It will be saved with the claim and sent to the claimant.")</p>
            }
            <div class="decision-actions">
                <button class="decision-cancel" type="button" @onclick="CloseClaimDecision" disabled="@IsDeciding">Cancel</button>
                <button class="@(ApproveDecision ? "decision-approve" : "decision-reject")" type="button" @onclick="ConfirmClaimDecision" disabled="@(IsDeciding || string.IsNullOrWhiteSpace(DecisionNote))">@(IsDeciding ? "Saving..." : ApproveDecision ? "Approve claim" : "Reject claim")</button>
            </div>
        </section>
    </div>
}

@if (SelectedMatch is not null)
{
    <div class="decision-backdrop" role="presentation" @onclick="CloseMatchDecision">
        <section class="decision-dialog" role="dialog" aria-modal="true" aria-labelledby="match-decision-title" @onclick:stopPropagation>
            <button class="decision-close" type="button" aria-label="Close" @onclick="CloseMatchDecision">&times;</button>
            <span class="decision-kicker">Match review</span>
            <h2 id="match-decision-title">@(ConfirmMatchDecision ? "Confirm this match?" : "Dismiss this match?")</h2>
            <p class="decision-summary"><strong>@SelectedMatch.LostTitle</strong> is matched with <strong>@SelectedMatch.FoundTitle</strong> at <strong>@SelectedMatch.Confidence%</strong>.</p>
            @if (ConfirmMatchDecision && SelectedMatch.Confidence < 70)
            {
                <p class="decision-warning" role="alert">This is a low-confidence match. Confirm only after verifying the item details, location, date, and available evidence.</p>
            }
            <label for="match-decision-note">@(ConfirmMatchDecision ? "Admin note" : "Reason for dismissal")</label>
            <textarea id="match-decision-note" @bind="MatchDecisionNote" placeholder="@(ConfirmMatchDecision ? "Optional note about why this match was confirmed" : "Explain why these reports are not the same item")"></textarea>
            @if (!ConfirmMatchDecision && string.IsNullOrWhiteSpace(MatchDecisionNote))
            {
                <p class="decision-hint">A dismissal reason is required and will be saved for audit history.</p>
            }
            <div class="decision-actions">
                <button class="decision-cancel" type="button" @onclick="CloseMatchDecision" disabled="@IsMatchDeciding">Cancel</button>
                <button class="@(ConfirmMatchDecision ? "decision-approve" : "decision-reject")" type="button" @onclick="SubmitMatchDecision" disabled="@(IsMatchDeciding || (!ConfirmMatchDecision && string.IsNullOrWhiteSpace(MatchDecisionNote)))">@(IsMatchDeciding ? "Saving..." : ConfirmMatchDecision ? "Confirm match" : "Dismiss match")</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly Dictionary<string, string> Sections = new() { ["overview"] = "Overview", ["reports"] = "All Reports", ["matches"] = "Matches", ["claims"] = "Claims", ["users"] = "Users", ["settings"] = "Settings" };
    private readonly string[] MatchStatuses = ["Awaiting Review", "Confirmed", "Dismissed"];
    private readonly string[] ClaimStatuses = ["Pending", "Approved", "Rejected", "Disputed"];
    private int PendingClaimCount => ClaimRows.Count(c => c.Status == "Pending");
    private int AwaitingMatchCount => SuggestedMatches.Count(m => m.Status == "Awaiting Review");
    private string ActiveSection { get; set; } = "overview";
    private string MatchStatusFilter { get; set; } = "Awaiting Review";
    private string ClaimStatusFilter { get; set; } = "Pending";
    private string ReportSearch { get; set; } = string.Empty;
    private string ReportTypeFilter { get; set; } = "all";
    private string ReportCategoryFilter { get; set; } = "all";
    private string ClaimSearch { get; set; } = string.Empty;
    private string UserSearch { get; set; } = string.Empty;
    private string UserRoleFilter { get; set; } = "all";
    private string UserStatusFilter { get; set; } = "all";
    private List<ReportItem> Reports { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private string SectionTitle => ActiveSection switch { "overview" => "Dashboard Overview", "reports" => "All Reports", "matches" => "Suggested Matches", "claims" => "Claims", "users" => "Users", _ => "Settings" };
    private IEnumerable<ReportItem> FilteredReports => Reports.Where(r => (ReportTypeFilter == "all" || (ReportTypeFilter == "lost" && r.Status == 0) || (ReportTypeFilter == "found" && r.Status == 1)) && (ReportCategoryFilter == "all" || CategoryOptions.GetCategoryName(r.Category) == ReportCategoryFilter) && ($"{r.Title} {r.ReportedBy} {r.Location}".Contains(ReportSearch, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<SuggestedMatch> FilteredSuggestedMatches => SuggestedMatches.Where(m => m.Status == MatchStatusFilter);
    private IEnumerable<AdminClaim> FilteredClaims => ClaimRows.Where(c => c.Status == ClaimStatusFilter && $"{c.Reference} {c.ItemTitle} {c.Claimant}".Contains(ClaimSearch, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<AdminUser> FilteredUsers => UserRows.Where(u => (UserRoleFilter == "all" || u.Role == UserRoleFilter) && (UserStatusFilter == "all" || (UserStatusFilter == "active" && !u.Suspended) || (UserStatusFilter == "suspended" && u.Suspended)) && $"{u.Name} {u.Identifier} {u.Email}".Contains(UserSearch, StringComparison.OrdinalIgnoreCase));

    private int AverageMatchScore => SuggestedMatches.Count == 0 ? 0 : (int)Math.Round(SuggestedMatches.Average(m => m.Confidence));

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            var reportsTask = ApiService.GetReportItemsAsync();
            var matchesTask = AdminService.GetMatchesAsync();
            var claimsTask = AdminService.GetClaimsAsync();
            await Task.WhenAll(reportsTask, matchesTask, claimsTask);

            Reports = reportsTask.Result;
            var matches = matchesTask.Result;
            var claims = claimsTask.Result;

            if (!matches.Ok || !claims.Ok)
            {
                ErrorMessage = matches.Error ?? claims.Error;
                return;
            }

            SuggestedMatches = matches.Data?.Select(ToSuggestedMatch).ToList() ?? [];
            var matchScores = matches.Data?.Where(m => m.Found is not null)
                .GroupBy(m => m.Found.Id)
                .ToDictionary(group => group.Key, group => (int)Math.Round(group.Max(m => m.Score))) ?? [];
            ClaimRows = claims.Data?.Select(claim => ToAdminClaim(claim, matchScores)).ToList() ?? [];
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenMatchDecision(SuggestedMatch match, bool confirm)
    {
        SelectedMatch = match;
        ConfirmMatchDecision = confirm;
        MatchDecisionNote = string.Empty;
        ErrorMessage = null;
    }

    private void CloseMatchDecision()
    {
        if (!IsMatchDeciding)
            SelectedMatch = null;
    }

    private async Task SubmitMatchDecision()
    {
        if (SelectedMatch is null)
            return;

        var match = SelectedMatch;
        IsMatchDeciding = true;
        var result = await AdminService.DecideMatchAsync(match.Id, ConfirmMatchDecision, MatchDecisionNote.Trim());
        if (!result.Ok)
        {
            ErrorMessage = result.Error;
            IsMatchDeciding = false;
            return;
        }

        match.Status = ConfirmMatchDecision ? "Confirmed" : "Dismissed";
        SelectedMatch = null;
        MatchDecisionNote = string.Empty;
        IsMatchDeciding = false;
    }

    private void OpenClaimDecision(AdminClaim claim, bool approve)
    {
        SelectedClaim = claim;
        ApproveDecision = approve;
        DecisionNote = string.Empty;
        ErrorMessage = null;
    }

    private void CloseClaimDecision()
    {
        if (!IsDeciding)
            SelectedClaim = null;
    }

    private async Task ConfirmClaimDecision()
    {
       if (SelectedClaim is null || string.IsNullOrWhiteSpace(DecisionNote))
    return;

        var claim = SelectedClaim;
        IsDeciding = true;
        var result = await AdminService.DecideClaimAsync(claim.Id, ApproveDecision, DecisionNote.Trim());
        if (!result.Ok)
        {
            ErrorMessage = result.Error;
            IsDeciding = false;
            return;
        }

        claim.Status = ApproveDecision ? "Approved" : "Rejected";
        SelectedClaim = null;
        DecisionNote = string.Empty;
        IsDeciding = false;
    }

    private static SuggestedMatch ToSuggestedMatch(MatchItem match) => new(
        match.Id,
        match.Lost.Title,
        $"{match.Lost.ReportedBy} - {match.Lost.Location} - {match.Lost.Date:MMM d}",
        match.Found.Title,
        $"{match.Found.ReportedBy} - {match.Found.Location} - {match.Found.Date:MMM d}",
        (int)Math.Round(match.Score),
        string.IsNullOrWhiteSpace(match.Reason) ? "Suggested by the matching service" : match.Reason,
        string.IsNullOrWhiteSpace(match.Status) ? "Awaiting Review" : NormalizeMatchStatus(match.Status),
        ReportImageUrl.Resolve(match.Lost.PhotoUrl),
        ReportImageUrl.Resolve(match.Found.PhotoUrl));

    private static AdminClaim ToAdminClaim(ClaimItem claim, IReadOnlyDictionary<int, int> matchScores) => new(
        claim.id,
        $"CL-{claim.id:0000}",
        claim.foundItemTitle,
        claim.claimerName,
        matchScores.TryGetValue(claim.foundReportId, out var score) ? score : null,
        claim.createdAt,
        NormalizeClaimStatus(claim.status));

    private static string NormalizeMatchStatus(string status) => status.ToLowerInvariant() switch
    {
        "approved" or "confirmed" => "Confirmed",
        "rejected" or "dismissed" => "Dismissed",
        _ => "Awaiting Review"
    };

    private static string NormalizeClaimStatus(int status) => status switch
    {
        1 => "Approved",
        2 => "Rejected",
        3 => "Disputed",
        _ => "Pending"
    };
    private static string StatusClass(int status) => status == 0 ? "status-lost" : status == 1 ? "status-found" : "status-review";
    private static string StatusLabel(int status) => status == 0 ? "Lost" : status == 1 ? "Found" : "Review";
    private static string ConfidenceClass(int? score) => score >= 85 ? "match-high" : score >= 70 ? "match-medium" : "match-low";
    private static string ClaimStatusClass(string status) => status == "Approved" ? "status-found" : status is "Rejected" or "Disputed" ? "status-rejected" : "status-lost";
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    private static string RoleClass(string role) => role switch { "Admin" => "role-admin", "Security Staff" => "role-security", _ => "role-student" };

    private List<SuggestedMatch> SuggestedMatches { get; set; } = [];
    private List<AdminClaim> ClaimRows { get; set; } = [];
    private AdminClaim? SelectedClaim { get; set; }
    private bool ApproveDecision { get; set; }
    private bool IsDeciding { get; set; }
    private string DecisionNote { get; set; } = string.Empty;
    private SuggestedMatch? SelectedMatch { get; set; }
    private bool ConfirmMatchDecision { get; set; }
    private bool IsMatchDeciding { get; set; }
    private string MatchDecisionNote { get; set; } = string.Empty;
    private readonly List<AdminUser> UserRows = [new("Kingsley Ofori-Atta", "10976543", "koforiatta@st.ug.edu.gh", "Student", 5, true), new("Kojo Mensah", "10987654", "kmensah@st.ug.edu.gh", "Student", 2, true), new("Ama Serwaa", "10945321", "aserwaa@st.ug.edu.gh", "Student", 3, true), new("Kwabena Tetteh", "STF-0042", "ktetteh@ug.edu.gh", "Admin", 0, true), new("Ama Kyei", "STF-0107", "akyei@ug.edu.gh", "Security Staff", 48, true), new("Abena Darko", "10911256", "adarko@st.ug.edu.gh", "Student", 4, false, true)];

    private sealed class SuggestedMatch(int id, string lostTitle, string lostDetails, string foundTitle, string foundDetails, int confidence, string reason, string status, string? lostImageUrl = null, string? foundImageUrl = null)
    {
        public int Id { get; } = id;
        public string LostTitle { get; } = lostTitle;
        public string LostDetails { get; } = lostDetails;
        public string FoundTitle { get; } = foundTitle;
        public string FoundDetails { get; } = foundDetails;
        public int Confidence { get; } = confidence;
        public string Reason { get; } = reason;
        public string Status { get; set; } = status;
        public string? LostImageUrl { get; } = lostImageUrl;
        public string? FoundImageUrl { get; } = foundImageUrl;
    }
    private sealed class AdminClaim(int id, string reference, string itemTitle, string claimant, int? matchPercent, DateTimeOffset submitted, string status)
    {
        public int Id { get; } = id;
        public string Reference { get; } = reference;
        public string ItemTitle { get; } = itemTitle;
        public string Claimant { get; } = claimant;
        public int? MatchPercent { get; } = matchPercent;
        public DateTimeOffset Submitted { get; } = submitted;
        public string Status { get; set; } = status;
    }
    private sealed record AdminUser(string Name, string Identifier, string Email, string Role, int ReportCount, bool Active, bool Suspended = false);
}
