@page "/"
@using lost_and_found.Components

<div class="hero-1">
    <div class="info">
        <h1>Lost something on campus? Found something?</h1>
        <p>Report it in seconds and let our matching system reconnect you with your belongings.</p>
        <div class="search-wrap">
            <select aria-label="Category">    
                <option>All Categories</option>
                <option>Electronics</option>
                <option>Wallets</option>
                <option>Clothing</option>
            </select>
            <input type="text" placeholder="Search by item, e.g. 'black wallet"/>
            <button >Search</button>
        </div>
    </div>
</div>

<div class="stats">
    <div class="stat-item">
        <div class="stat-value">1,284</div>
        <div class="stat-label">Items Reported</div>
    </div>

    <div class="stat-item">
        <div class="stat-value">412</div>
        <div class="stat-label">Matches Found</div>
    </div>

    <div class="stat-item">
        <div class="stat-value">356</div>
        <div class="stat-label">Successfully Reunited</div>
    </div>
</div>

<div class="reports">
    <div class="reports-header">
        <h3>Recent Reports</h3>
        <a class="view-all" href="/browse">View All →</a>
    </div>

    <div class="report-items">
        <ItemCard Title="Black Leather Wallet"
                  Category="Wallet"
                  Status="Lost"
                  ImageUrl="/images/wallet.jpg"
                  Location="Balme Library"
                  TimeAgo="2 days ago" />

        <ItemCard Title="iPhone 13 (Blue)"
                  Category="Electronics"
                  Status="Found"
                  ImageUrl="/images/iphone13.jpg"
                  Location="Night Market"
                  TimeAgo="1 day ago" />

        <ItemCard Title="Blue Water Bottle"
                  Category="Personal Item"
                  Status="Found"
                  ImageUrl="/images/waterbottle.jpg"
                  Location="JQB Complex"
                  TimeAgo="3 days ago" />

        <ItemCard Title="Student ID Card"
                  Category="ID Card"
                  Status="Lost"
                  ImageUrl="/images/idcard.jpg"
                  Location="Commonwealth Hall"
                  TimeAgo="Today" />
    </div>
</div>

