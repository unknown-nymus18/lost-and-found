@page "/forgot-password"
@using lost_and_found.Components
@using lost_and_found.Services
@layout EmptyLayout
@inject ApiService ApiService

<div class="forgot-password">
    <AuthPanel Headline="Reuniting the campus community, one item at a time."
               Blurb="Sign in with your University of Ghana account to report items, track claims, and get notified the moment a match is found." />

    <div class="right">
        <form class="form" @onsubmit="Submit">
            <div class="key-icon" aria-hidden="true">🔑</div>

            <h2 class="heading">Forgot your password?</h2>
            <p class="subtitle">
                Enter the UG email linked to your account and we'll send you a link to reset your password.
            </p>

            <label class="field">
                <span class="field-label">UG Email Address</span>
                <input type="email" placeholder="you@st.ug.edu.gh" @bind="Email" />
            </label>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="form-error" role="alert">@errorMessage</p>
            }

            <button type="submit" class="submit-btn" disabled="@isSubmitting">
                @(isSubmitting ? "Sending..." : "Send Reset Link")
            </button>

            @if (isSent)
            {
                <div class="sent-panel" role="status">
                    <span class="sent-icon" aria-hidden="true">✉️</span>
                    <div>
                        <strong>Check your inbox</strong>
                        <p>If an account exists for that email, a reset link is on its way. It expires in 30 minutes.</p>
                    </div>
                </div>
            }

            <a class="back-link" href="/sign-in">&#8592; Back to Sign In</a>

            <p class="sso-note">
                Using UG Student SSO? Reset your password on the UG IT Services portal instead.
            </p>
        </form>
    </div>
</div>

@code {
    private string Email { get; set; } = string.Empty;
    private bool isSubmitting;
    private bool isSent;
    private string? errorMessage;

    private async Task Submit()
    {
        if (isSubmitting) return;

        if (string.IsNullOrWhiteSpace(Email))
        {
            errorMessage = "Please enter your UG email address.";
            return;
        }

        errorMessage = null;
        isSubmitting = true;
        try
        {
            var result = await ApiService.RequestPasswordReset(Email.Trim());

            if (result.Ok)
                isSent = true;
            else
                errorMessage = result.Error;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
