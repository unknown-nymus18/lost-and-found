@page "/notifications"
@implements IDisposable
@using lost_and_found.Models
@using lost_and_found.Services
@inject ApiService ApiService

<div class="notifications">
    <div class="header">
        <div>
            <h1>Notifications</h1>
            <p class="sub">
                @(UnreadCount == 0
                    ? "You're all caught up."
                    : $"You have {UnreadCount} unread notification{(UnreadCount == 1 ? "" : "s")}")
            </p>
        </div>

        @if (UnreadCount > 0)
        {
            <button type="button" class="mark-all" @onclick="MarkAllAsRead">&#10003; Mark all as read</button>
        }
    </div>

    <div class="tabs" role="tablist">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" class="tab @(activeTab == tab ? "is-active" : "")"
                    aria-selected="@(activeTab == tab)" @onclick="() => activeTab = tab">
                @TabLabel(tab)
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="error" role="alert">@errorMessage</p>
    }

    @if (isLoading)
    {
        <div class="empty"><p>Loading notifications...</p></div>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty">
            <h2>Nothing here yet</h2>
            <p>Match alerts, claim updates and messages will show up on this page.</p>
        </div>
    }
    else
    {
        <div class="list">
            @foreach (var n in Visible)
            {
                <div class="item @(n.IsRead ? "" : "unread clickable")" @onclick="() => MarkOneAsRead(n)">
                    <div class="icon @IconClass(n.Type)" aria-hidden="true">@(n.Title == "Claim rejected" ? "❌" : IconGlyph(n.Type))</div>

                    <div class="body">
                        <strong class="title">@n.Title</strong>
                        <p class="text">@n.Body</p>

                        @if (!string.IsNullOrWhiteSpace(n.AdminNote))
                        {
                            <div class="note">
                                <span class="note-label">@(n.Title == "Claim rejected" ? "Reason" : "Admin note")</span>
                                <p class="note-text">@n.AdminNote</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(n.ActionLabel) && !string.IsNullOrWhiteSpace(n.ActionUrl))
                        {
                            <a class="action" href="@n.ActionUrl">@n.ActionLabel &rarr;</a>
                        }
                    </div>

                    <div class="meta">
                        <span class="time">@FormatTimeAgo(n.CreatedAt)</span>
                        @if (!n.IsRead)
                        {
                            <span class="dot" aria-label="Unread"></span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <p class="footnote">Manage which alerts you receive in Profile &rarr; Notification preferences.</p>
</div>

@code {
    private static readonly string[] Tabs = { "all", "unread", "matches", "claims" };

    private List<NotificationItem> items = new();
    private string activeTab = "all";
    private bool isLoading = true;
    private string? errorMessage;
    private System.Threading.Timer? refreshTimer;

    private int UnreadCount => items.Count(n => !n.IsRead);

    private List<NotificationItem> Visible => activeTab switch
    {
        "unread" => items.Where(n => !n.IsRead).ToList(),
        "matches" => items.Where(n => n.Type == "match").ToList(),
        "claims" => items.Where(n => n.Type == "claim").ToList(),
        _ => items,
    };

    private string TabLabel(string tab) => tab switch
    {
        "unread" => UnreadCount > 0 ? $"Unread ({UnreadCount})" : "Unread",
        "matches" => "Matches",
        "claims" => "Claims",
        _ => "All",
    };

    private static string IconGlyph(string type) => type switch
    {
        "match" => "⚡",
        "claim" => "✅",
        "message" => "💬",
        "expiry" => "⏳",
        "reunited" => "🎉",
        _ => "🔔",
    };

    private static string IconClass(string type) => type switch
    {
        "match" => "icon-match",
        "claim" => "icon-claim",
        "message" => "icon-message",
        "expiry" => "icon-expiry",
        "reunited" => "icon-reunited",
        _ => "icon-default",
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(showError: true);
        isLoading = false;

        // The API has no push channel, so poll for new notifications every 30 seconds.
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadAsync(showError: false);
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync(bool showError)
    {
        var result = await ApiService.GetNotifications();
        if (result is null)
        {
            if (showError)
                errorMessage = "Couldn't load your notifications. Please log in and try again.";
            return;
        }

        errorMessage = null;
        items = result;
    }

    private async Task MarkOneAsRead(NotificationItem n)
    {
        if (n.IsRead)
            return;

        n.IsRead = true; // optimistic update
        var result = await ApiService.MarkNotificationRead(n.Id);
        if (!result.Ok)
        {
            n.IsRead = false;
            errorMessage = result.Error;
        }
    }

    private async Task MarkAllAsRead()
    {
        var unreadIds = items.Where(n => !n.IsRead).Select(n => n.Id).ToList();
        var result = await ApiService.MarkAllNotificationsRead(unreadIds);
        if (!result.Ok)
        {
            errorMessage = result.Error;
            await LoadAsync(showError: false); // resync with what the server actually saved
            return;
        }

        errorMessage = null;
        foreach (var n in items)
            n.IsRead = true;
    }

    private static string FormatTimeAgo(DateTimeOffset date)
    {
        var diff = DateTimeOffset.UtcNow - date;

        if (diff.TotalDays >= 7) return $"{Math.Floor(diff.TotalDays / 7)} week{(diff.TotalDays < 14 ? "" : "s")} ago";
        if (diff.TotalDays >= 2) return $"{Math.Floor(diff.TotalDays)} days ago";
        if (diff.TotalDays >= 1) return "Yesterday";
        if (diff.TotalHours >= 1) return $"{Math.Floor(diff.TotalHours)} hours ago";
        if (diff.TotalMinutes >= 1) return $"{Math.Floor(diff.TotalMinutes)} min ago";
        return "Just now";
    }

    public void Dispose() => refreshTimer?.Dispose();
}
