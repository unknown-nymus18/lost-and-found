@page "/notifications"
@implements IDisposable
@using lost_and_found.Models
@using lost_and_found.Services
@using lost_and_found.Components
@inject ApiService ApiService

<div class="notifications">
    <div class="header">
        <div>
            <h1>Notifications</h1>
            <p class="sub">
                @(UnreadCount == 0
                    ? "You're all caught up."
                    : $"You have {UnreadCount} unread notification{(UnreadCount == 1 ? "" : "s")}")
            </p>
        </div>

        @if (UnreadCount > 0)
        {
            <button type="button" class="mark-all" @onclick="MarkAllAsRead">&#10003; Mark all as read</button>
        }
    </div>

    <div class="tabs" role="tablist">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" class="tab @(activeTab == tab ? "is-active" : "")"
                    aria-selected="@(activeTab == tab)" @onclick="() => activeTab = tab">
                @TabLabel(tab)
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="error" role="alert">@errorMessage</p>
    }

    @if (isLoading)
    {
        <div class="empty"><p>Loading notifications...</p></div>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty">
            <h2>Nothing here yet</h2>
            <p>Match alerts, claim updates and messages will show up on this page.</p>
        </div>
    }
    else
    {
        <div class="list">
            @foreach (var n in Visible)
            {
                <div class="item @(n.IsRead ? "" : "unread clickable")" @onclick="() => MarkOneAsRead(n)">
                    <div class="icon @(IsRejected(n) ? "icon-rejected" : IconClass(n.Type))" aria-hidden="true">@(IsRejected(n) ? "❌" : IconGlyph(n.Type))</div>

                    <div class="body">
                        <strong class="title">@n.Title</strong>
                        <p class="text">@n.Body</p>

                        @if (!string.IsNullOrWhiteSpace(n.AdminNote))
                        {
                            <div class="note">
                                <span class="note-label">@(IsRejected(n) ? "Reason" : "Admin note")</span>
                                <p class="note-text">@n.AdminNote</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(n.ActionLabel) && !string.IsNullOrWhiteSpace(n.ActionUrl))
                        {
                            <a class="action" href="@n.ActionUrl">@n.ActionLabel &rarr;</a>
                        }
                    </div>

                    <div class="meta">
                        <span class="time">@FormatTimeAgo(n.CreatedAt)</span>
                        @if (!n.IsRead)
                        {
                            <span class="dot" aria-label="Unread"></span>
                        }
                    </div>

                    @if (IsApproval(n) || IsMatch(n))
                    {
                        <div class="actions">
                            <button type="button" class="btn-details"
                                    @onclick="() => OpenDetails(n)" @onclick:stopPropagation="true">
                                View details
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <p class="footnote">Manage which alerts you receive in Profile &rarr; Notification preferences.</p>
</div>

@if (selected is not null)
{
    <div class="dlg-backdrop" role="presentation" @onclick="CloseDetails">
        <section class="dlg" role="dialog" aria-modal="true" aria-labelledby="dlg-title" @onclick:stopPropagation="true">
            <button type="button" class="dlg-close" aria-label="Close" @onclick="CloseDetails">&times;</button>

            <h2 id="dlg-title" class="dlg-title">@(detailClaim?.foundItemTitle ?? selected.Title)</h2>
            <p class="dlg-muted">@selected.Body</p>

            @if (!string.IsNullOrWhiteSpace(selected.AdminNote))
            {
                <div class="note">
                    <span class="note-label">Admin note</span>
                    <p class="note-text">@selected.AdminNote</p>
                </div>
            }

            @if (detailLoading)
            {
                <p class="dlg-muted">Loading details...</p>
            }
            else if (!string.IsNullOrEmpty(detailError))
            {
                <p class="error" role="alert">@detailError</p>
            }
            else if (detailMatch is not null)
            {
                <div class="dlg-section">
                    <span class="dlg-label">Matched reports (@detailMatch.Score%)</span>
                    <div class="match-notification-details">
                        <div>
                            <strong>Lost item: @detailMatch.Lost.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(detailMatch.Lost.PhotoUrl))
                            {
                                <img class="dlg-photo" src="@ReportImageUrl.Resolve(detailMatch.Lost.PhotoUrl)" alt="Photo of @detailMatch.Lost.Title" />
                            }
                            <p>@detailMatch.Lost.Description</p>
                            <small>@detailMatch.Lost.Location · @detailMatch.Lost.Date.ToString("MMM d, yyyy")</small>
                        </div>
                        <div>
                            <strong>Found item: @detailMatch.Found.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(detailMatch.Found.PhotoUrl))
                            {
                                <img class="dlg-photo" src="@ReportImageUrl.Resolve(detailMatch.Found.PhotoUrl)" alt="Photo of @detailMatch.Found.Title" />
                            }
                            <p>@detailMatch.Found.Description</p>
                            <small>@detailMatch.Found.Location · @detailMatch.Found.Date.ToString("MMM d, yyyy")</small>
                        </div>
                    </div>
                </div>
            }
            else if (detailClaim is null)
            {
                <p class="dlg-muted">The claimant will collect this item using the handover details you provided.</p>
            }
            else if (detailReport is null)
            {
                <p class="error" role="alert">Couldn't load the item details. Please try again.</p>
            }
            else
            {
                <div class="dlg-section">
                    <span class="dlg-label">Item</span>
                    @if (!string.IsNullOrWhiteSpace(detailReport.PhotoUrl))
                    {
                        <img class="dlg-photo" src="@ReportImageUrl.Resolve(detailReport.PhotoUrl)" alt="Photo of @detailReport.Title" />
                    }
                    <dl class="dlg-grid">
                        <dt>Item</dt><dd>@detailReport.Title</dd>
                        <dt>Found at</dt><dd>@detailReport.Location</dd>
                        <dt>Date</dt><dd>@detailReport.Date.ToString("MMM d, yyyy")</dd>
                    </dl>
                </div>

                <div class="dlg-section">
                    <span class="dlg-label">Handover details</span>
                    @if (detailReport.Handover is { } h)
                    {
                        <dl class="dlg-grid">
                            @if (!string.IsNullOrWhiteSpace(h.FinderName))
                            {
                                <dt>Finder</dt><dd>@h.FinderName</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(h.DropOffLocation))
                            {
                                <dt>Drop-off location</dt><dd>@h.DropOffLocation</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(h.ContactPhone))
                            {
                                <dt>Phone</dt><dd><a href="tel:@h.ContactPhone">@h.ContactPhone</a></dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="dlg-muted">Handover details aren't available yet. Follow the admin's note above.</p>
                    }
                </div>

                <div class="dlg-actions">
                    <button type="button" class="dlg-success" disabled title="Coming soon">Successful</button>
                    <button type="button" class="dlg-issue" disabled title="Coming soon">Report issue</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly string[] Tabs = { "all", "unread", "matches", "claims" };

    private List<NotificationItem> items = new();
    private string activeTab = "all";
    private bool isLoading = true;
    private string? errorMessage;
    private System.Threading.Timer? refreshTimer;

    // View details popup state
    private NotificationItem? selected;
    private ClaimItem? detailClaim;
    private ReportItem? detailReport;
    private MatchItem? detailMatch;
    private bool detailLoading;
    private string? detailError;

    private int UnreadCount => items.Count(n => !n.IsRead);

    private List<NotificationItem> Visible => activeTab switch
    {
        "unread" => items.Where(n => !n.IsRead).ToList(),
        "matches" => items.Where(n => n.Type == "match").ToList(),
        "claims" => items.Where(n => n.Type == "claim").ToList(),
        _ => items,
    };

    private string TabLabel(string tab) => tab switch
    {
        "unread" => UnreadCount > 0 ? $"Unread ({UnreadCount})" : "Unread",
        "matches" => "Matches",
        "claims" => "Claims",
        _ => "All",
    };

    private static bool IsApproval(NotificationItem n) => n.Type == "claim" && n.Title == "Claim approved";
    private static bool IsMatch(NotificationItem n) => string.Equals(n.Type, "match", StringComparison.OrdinalIgnoreCase);
    private static bool IsRejected(NotificationItem n) => n.Type == "claim" && n.Title == "Claim rejected";

    private static string IconGlyph(string type) => type switch
    {
        "match" => "⚡",
        "claim" => "✅",
        "message" => "💬",
        "expiry" => "⏳",
        "reunited" => "🎉",
        _ => "🔔",
    };

    private static string IconClass(string type) => type switch
    {
        "match" => "icon-match",
        "claim" => "icon-claim",
        "message" => "icon-message",
        "expiry" => "icon-expiry",
        "reunited" => "icon-reunited",
        _ => "icon-default",
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(showError: true);
        isLoading = false;

        // The API has no push channel, so poll for new notifications every 30 seconds.
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadAsync(showError: false);
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync(bool showError)
    {
        var result = await ApiService.GetNotifications();
        if (result is null)
        {
            if (showError)
                errorMessage = "Couldn't load your notifications. Please log in and try again.";
            return;
        }

        errorMessage = null;
        items = result;
    }

    private async Task OpenDetails(NotificationItem n)
    {
        selected = n;
        detailClaim = null;
        detailReport = null;
        detailMatch = null;
        detailError = null;
        detailLoading = true;

        await MarkOneAsRead(n);

        if (IsMatch(n))
        {
            if (!n.ReferenceId.HasValue)
            {
                detailError = "No matched report reference is available for this notification.";
            }
            else
            {
                var matches = await ApiService.GetMyMatches();
                detailMatch = matches?.FirstOrDefault(match => match.Id == n.ReferenceId.Value);
                if (detailMatch is null)
                    detailError = "Couldn't load the matched report details. Please try again.";
            }

            detailLoading = false;
            return;
        }

        // /claims/mine only contains claims this user made, so a match means they are the claimant.
        // No match means they are the finder, who just sees the message and note.
        var claims = await ApiService.GetUserClaims();
        if (claims is null)
        {
            detailError = "Couldn't load the claim details. Please try again.";
            detailLoading = false;
            return;
        }

        detailClaim = claims.FirstOrDefault(c => c.id == n.ReferenceId);
        if (detailClaim is not null)
            detailReport = await ApiService.GetFoundItemAuthenticated(detailClaim.foundReportId);

        detailLoading = false;
    }

    private void CloseDetails()
    {
        selected = null;
        detailClaim = null;
        detailReport = null;
        detailMatch = null;
        detailError = null;
        detailLoading = false;
    }

    private async Task MarkOneAsRead(NotificationItem n)
    {
        if (n.IsRead)
            return;

        n.IsRead = true; // optimistic update
        var result = await ApiService.MarkNotificationRead(n.Id);
        if (!result.Ok)
        {
            n.IsRead = false;
            errorMessage = result.Error;
        }
    }

    private async Task MarkAllAsRead()
    {
        var unreadIds = items.Where(n => !n.IsRead).Select(n => n.Id).ToList();
        var result = await ApiService.MarkAllNotificationsRead(unreadIds);
        if (!result.Ok)
        {
            errorMessage = result.Error;
            await LoadAsync(showError: false); // resync with what the server actually saved
            return;
        }

        errorMessage = null;
        foreach (var n in items)
            n.IsRead = true;
    }

    private static string FormatTimeAgo(DateTimeOffset date)
    {
        var diff = DateTimeOffset.UtcNow - date;

        if (diff.TotalDays >= 7) return $"{Math.Floor(diff.TotalDays / 7)} week{(diff.TotalDays < 14 ? "" : "s")} ago";
        if (diff.TotalDays >= 2) return $"{Math.Floor(diff.TotalDays)} days ago";
        if (diff.TotalDays >= 1) return "Yesterday";
        if (diff.TotalHours >= 1) return $"{Math.Floor(diff.TotalHours)} hours ago";
        if (diff.TotalMinutes >= 1) return $"{Math.Floor(diff.TotalMinutes)} min ago";
        return "Just now";
    }

    public void Dispose() => refreshTimer?.Dispose();
}
