@page "/item-detail/{Kind}/{Id:int}"
@using lost_and_found.Models
@using lost_and_found.Services

@inject ApiService ApiService

@if (isLoading)
{
    <div class="item-detail">
        <p>Loading...</p>
    </div>
}
else if (item is null)
{
    <div class="item-detail">
        <section class="item-main">
            <a class="back-link" href="/browse">&#8592; Back to results</a>
            <p>Sorry, we couldn't find that item.</p>
        </section>
    </div>
}
else
{
    <div class="item-detail">
        <section class="item-main">
            <a class="back-link" href="/browse">&#8592; Back to results</a>

            <div class="item-img" role="img" aria-label="Photo of @item.Title" style="@ImageStyle"></div>

            <div class="item-heading">
                <span class="status @StatusClass">@item.Kind</span>
                <h1>@item.Title</h1>
            </div>

            <div class="item-meta">
                <span>&#128205; @item.Location</span>
                <span>&#9632; @DateLabel @item.Date.ToLocalTime().ToString("MMM d, yyyy")</span>
                <span>&#9644; @CategoryName</span>
            </div>

            <section class="description">
                <h2>Description</h2>
                <p>@item.Description</p>
            </section>

            <div class="reporter">
                <div class="avatar" aria-hidden="true"></div>
                <div>
                    <strong>Reported by @item.ReportedBy</strong>
                    <span>Posted @item.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                </div>
            </div>
        </section>

        @if (Kind == "found")
        {
            <section class="item-actions">
                <div class="match-alert">
                    <strong>&#9889; 91% Potential Match</strong>
                    <p>This matches a Lost Report: "Blue Steel Bottle" filed 2 days ago near JQB Complex.</p>
                    <button class="dark-button" type="button">View Matching Report</button>
                </div>

                <div class="claim-panel">
                    <h2>Claim This Item</h2>

                    <div class="claim-steps" aria-label="Claim progress">
                        <div class="step active"><span>1</span><small>Submit Proof</small></div>
                        <div class="step-line"></div>
                        <div class="step"><span>2</span><small>Admin Review</small></div>
                        <div class="step-line"></div>
                        <div class="step"><span>3</span><small>Resolution</small></div>
                    </div>

                    <label class="proof-label" for="proof">Proof of Ownership</label>
                    <textarea id="proof"
                              placeholder="Describe a unique detail only the true owner would know (e.g. contents, purchase receipt)..."
                              @bind="proofDescription" required></textarea>
                    <button class="primary-button" type="button" @onclick="MakeClaim"
                            disabled="@(isSubmitting || claimSubmitted)">
                        @(isSubmitting ? "Submitting..." : claimSubmitted ? "Claim Submitted" : "Submit Claim Request")
                    </button>
                    @if (!string.IsNullOrEmpty(claimMessage))
                    {
                        <p class="claim-feedback @(claimSubmitted ? "success" : "error")" role="status">@claimMessage</p>
                    }

                    <p class="claim-note">&#128172; Once approved, you can message the finder directly to arrange pickup.</p>
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string Kind { get; set; }

    private ReportItem? item;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool claimSubmitted;
    private string? claimMessage;

    // Adjust these to match your real category IDs.
    private static readonly Dictionary<int, string> Categories = new()
    {
        [0] = "Personal Item",
        [1] = "Electronics",
        [2] = "Clothing",
        [3] = "Documents",
        [4] = "Other"
    };

    private string StatusClass =>
        (item?.Kind ?? string.Empty).Contains("lost", StringComparison.OrdinalIgnoreCase) ? "lost" : "found";

    private string DateLabel => StatusClass == "lost" ? "Lost on" : "Found on";

    private string CategoryName =>
        item is not null && Categories.TryGetValue(item.Category, out var name) ? name : "Other";

    private string ImageStyle =>
        string.IsNullOrWhiteSpace(item?.PhotoUrl)
            ? string.Empty
            : $"background-image: url('{ReportImageUrl.Resolve(item!.PhotoUrl)}'); background-size: cover; background-position: center;";

    public string proofDescription { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            item = Kind == "lost" ? await ApiService.GetLostItemById(Id) : await ApiService.GetFoundItemById(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load item {Id}: {ex.Message}");
            item = null;
        }
        isLoading = false;
    }


    private async Task MakeClaim()
    {
        if (string.IsNullOrWhiteSpace(proofDescription))
        {
            claimSubmitted = false;
            claimMessage = "Please describe how you can verify ownership.";
            return;
        }

        isSubmitting = true;
        claimMessage = null;

        try
        {
            var claim = await ApiService.MakeClaim(Id.ToString(), proofDescription.Trim());
            if (claim is null)
            {
                claimSubmitted = false;
                claimMessage = "We couldn't submit your claim. Please sign in and try again.";
                return;
            }

            claimSubmitted = true;
            claimMessage = "Your claim was submitted successfully.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to submit claim for found item {Id}: {ex.Message}");
            claimSubmitted = false;
            claimMessage = "Something went wrong while submitting your claim. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}