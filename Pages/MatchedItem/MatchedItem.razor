@page "/matched-item/{Kind}/{ReportId:int}"
@using lost_and_found.Models
@using lost_and_found.Services
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation

<main class="matched-item-page">
    <a class="back-link" href="/claims">&larr; Back to My Reports &amp; Claims</a>

    @if (isLoading)
    {
        <p class="page-state">Loading matched reports...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="page-state error" role="alert">@errorMessage</p>
    }
    else if (matches.Count > 0)
    {
        <header class="match-header">
            <div>
                <span class="eyebrow">Matched item</span>
                <h1>Matches for @ReportTitle</h1>
                <p>@matches.Count possible match@(matches.Count == 1 ? "" : "es") found.</p>
            </div>
        </header>

        <section class="reported-item-section" aria-labelledby="reported-item-heading">
            <h2 id="reported-item-heading">Your reported item</h2>
            @if (ReportedItem is { } reportedItem)
            {
                <article class="reported-item-card">
                    <div class="reported-item-photo" role="img" aria-label="Photo of @reportedItem.Title"
                         style="@PhotoStyle(reportedItem)"></div>
                    <div class="reported-item-content">
                        <span class="report-label">@(IsLostReport ? "Lost report" : "Found report")</span>
                        <h3>@reportedItem.Title</h3>
                        <p>@reportedItem.Description</p>
                        <div class="report-meta">
                            <span>Location: @reportedItem.Location</span>
                            <span>Date: @reportedItem.Date.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                </article>
            }
        </section>

        <section class="matches-section" aria-labelledby="matches-heading">
            <div class="matches-list-heading">
                <h2 id="matches-heading">Possible matches</h2>
                <span>@matches.Count</span>
            </div>
            <div class="matches-scroll" tabindex="0" aria-label="Scrollable possible matches">
                @foreach (var match in matches)
                {
                    var counterpart = OtherReport(match);
                    var counterpartKind = IsLostReport ? "found" : "lost";
                    <article class="match-result">
                        <div class="counterpart-photo" role="img" aria-label="Photo of @counterpart.Title"
                             style="@PhotoStyle(counterpart)"></div>
                        <div class="counterpart-content">
                            <div class="match-result-heading">
                                <span class="report-label">@(IsLostReport ? "Found item" : "Lost item")</span>
                                <span class="match-score">@match.Score.ToString("0.#") score</span>
                            </div>
                            <h3>@counterpart.Title</h3>
                            <p class="counterpart-description">@counterpart.Description</p>
                            <div class="report-meta">
                                <span>Location: @counterpart.Location</span>
                                <span>Date: @counterpart.Date.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                            <p class="match-reason">@match.Reason</p>
                            <a class="report-details-link" href="@($"/item-detail/{counterpartKind}/{counterpart.Id}")">View
                                item details</a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </main>

@code {
    [Parameter] public string Kind { get; set; } = string.Empty;
    [Parameter] public int ReportId { get; set; }

    private List<MatchItem> matches = [];
    private bool isLoading = true;
    private string? errorMessage;

    private bool IsLostReport => Kind.Equals("lost", StringComparison.OrdinalIgnoreCase);
    private ReportItem? ReportedItem => matches.Count == 0
        ? null
        : IsLostReport ? matches[0].Lost : matches[0].Found;
    private string ReportTitle => ReportedItem?.Title ?? "this report";

    private ReportItem OtherReport(MatchItem match) => IsLostReport ? match.Found : match.Lost;

    private static string PhotoStyle(ReportItem item) => string.IsNullOrWhiteSpace(item.PhotoUrl)
        ? string.Empty
        : $"background-image: url('{ReportImageUrl.Resolve(item.PhotoUrl)}')";

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthService.isLoggedIn)
        {
            Navigation.NavigateTo("/sign-in");
            return;
        }

        isLoading = true;
        errorMessage = null;
        matches = [];

        var response = await ApiService.GetMyMatches();
        if (response is null)
        {
            errorMessage = "Couldn't load the matched reports. Please try again.";
        }
        else if (Kind.Equals("lost", StringComparison.OrdinalIgnoreCase))
        {
            matches = response
                .Where(candidate => candidate.Lost.Id == ReportId)
                .OrderByDescending(candidate => candidate.Score)
                .ThenByDescending(candidate => candidate.CreatedAt)
                .ToList();
        }
        else if (Kind.Equals("found", StringComparison.OrdinalIgnoreCase))
        {
            matches = response
                .Where(candidate => candidate.Found.Id == ReportId)
                .OrderByDescending(candidate => candidate.Score)
                .ThenByDescending(candidate => candidate.CreatedAt)
                .ToList();
        }
        else
        {
            errorMessage = "This report kind is not supported.";
        }

        if (string.IsNullOrEmpty(errorMessage) && matches.Count == 0)
            errorMessage = "We couldn't find a match for this report.";

        isLoading = false;
    }
}