@page "/reset-password"
@using lost_and_found.Components
@using lost_and_found.Services
@layout EmptyLayout
@inject ApiService ApiService

<div class="reset-password">
    <AuthPanel Headline="Reuniting the campus community, one item at a time."
               Blurb="Sign in with your University of Ghana account to report items, track claims, and get notified the moment a match is found." />

    <div class="right">
        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div class="form">
                <div class="icon warn" aria-hidden="true">⚠️</div>
                <h2 class="heading">This link isn't valid</h2>
                <p class="subtitle">
                    Reset links expire after 30 minutes and can only be used once.
                    Request a new one to continue.
                </p>
                <a class="submit-link" href="/forgot-password">Request a New Link</a>
                <a class="back-link" href="/sign-in">&#8592; Back to Sign In</a>
            </div>
        }
        else if (isDone)
        {
            <div class="form">
                <div class="icon success" aria-hidden="true">✅</div>
                <h2 class="heading">Password updated</h2>
                <p class="subtitle">
                    Your password has been changed. You can now sign in with your new password.
                </p>
                <a class="submit-link" href="/sign-in">Go to Sign In</a>
            </div>
        }
        else
        {
            <form class="form" @onsubmit="Submit">
                <div class="icon" aria-hidden="true">🔒</div>

                <h2 class="heading">Set a new password</h2>
                <p class="subtitle">
                    Choose a new password for your UG Lost &amp; Found account.
                </p>

                <label class="field">
                    <span class="field-label">New Password</span>
                    <input type="password" placeholder="At least 8 characters" @bind="Password" />
                </label>

                <label class="field">
                    <span class="field-label">Confirm New Password</span>
                    <input type="password" placeholder="Re-enter your password" @bind="ConfirmPassword" />
                </label>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="form-error" role="alert">@errorMessage</p>
                }

                <button type="submit" class="submit-btn" disabled="@isSubmitting">
                    @(isSubmitting ? "Updating..." : "Reset Password")
                </button>

                <a class="back-link" href="/sign-in">&#8592; Back to Sign In</a>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;

    private bool isSubmitting;
    private bool isDone;
    private string? errorMessage;

    private async Task Submit()
    {
        if (isSubmitting) return;

        errorMessage = Validate();
        if (errorMessage is not null) return;

        isSubmitting = true;
        try
        {
            var result = await ApiService.ResetPassword(Token!, Password);

            if (result.Ok)
                isDone = true;
            else
                errorMessage = result.Error;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string? Validate()
    {
        if (Password.Length < 8) return "Your password must be at least 8 characters.";
        if (Password != ConfirmPassword) return "Those passwords don't match.";
        return null;
    }
}
