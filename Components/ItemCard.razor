<div class="card p-3 shadow-sm mb-3">
    <h4 class="card-title">@Title</h4>
    <p class="card-text">@Description</p>
    
    <button class="btn btn-primary">
        @ButtonText
    </button>
</div>

@code{
    string Title = "This is the Item";
    string Description = "This is the description of the item. It provides more details about the item being displayed.";
    string ButtonText = "View Details";
}