@using System.Dynamic
@using Microsoft.AspNetCore.Components
@* @using Microsoft.AspNetCore.Components *@
@inject NavigationManager Navigation
<a href="/item-detail">
    
    <div class="report-card">
        <div class="card-media" role="img" aria-label="@Title" style=@($"background-image: url('{ImageUrl}');")></div>

        <div class="card-body">
            <span class="status @StatusClass">@Status</span>

            <h4 class="card-title">@Title</h4>

            <span class="category">@Category</span>

            <div class="card-meta">@Location � @TimeAgo</div>
        </div>
    </div>
</a>

@code {
    [Parameter] public string Title { get; set; } = "Item title";
    [Parameter] public string Category { get; set; } = "Category";
    [Parameter] public string ImageUrl { get; set; } = "https://picsum.photos/id/237/200/300";
    [Parameter] public string Status { get; set; } = "Found";
    [Parameter] public string Location { get; set; } = "Location";
    [Parameter] public string TimeAgo { get; set; } = "some time ago";

    private string StatusClass => (Status ?? string.Empty).ToLower().Contains("lost") ? "lost" : "found";

}
